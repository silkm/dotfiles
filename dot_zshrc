# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Init completion system
autoload -Uz compinit
compinit -u

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="${HOME}/.config/emacs/bin:$PATH"
if [ -d "$(brew --prefix)/opt/grep/libexec/gnubin" ]; then
  export PATH="$(brew --prefix)/opt/grep/libexec/gnubin:$PATH"
fi
if [ -d "$HOME/scripts/interactive-analysis-environment" ]; then
  export PATH="$HOME/scripts/interactive-analysis-environment:$PATH"
fi

# Google Cloud SDK
if [ -d "$(brew --prefix)/share/google-cloud-sdk" ]; then
  source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"
  source "$(brew --prefix)/share/google-cloud-sdk/completion.zsh.inc"
fi

# GHCup
[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env"

# openblas (for R packages etc.)
export LDFLAGS="-L$(brew --prefix)/opt/openblas/lib"
export CPPFLAGS="-I$(brew --prefix)/opt/openblas/include"
export PKG_CONFIG_PATH="$(brew --prefix)/opt/openblas/lib/pkgconfig"

# Direnv
eval "$(direnv hook zsh)"

# fzf — fuzzy finder with fd as the source
if [ -d "$(brew --prefix)/opt/fzf" ]; then
  source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
  source "$(brew --prefix)/opt/fzf/shell/completion.zsh"

  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

  # Rebind: Ctrl-F = file picker, Ctrl-G = cd into subdir. Ctrl-R stays on history.
  bindkey -r '^T'
  bindkey -r '\ec'
  bindkey '^F' fzf-file-widget
  bindkey '^G' fzf-cd-widget
fi

# --- Aliases ---
alias ls='eza'

alias R='R --no-save'
alias r='R --no-save'

alias ggssh='gcloud compute config-ssh'
alias ggls='gcloud storage ls'
alias ggLs='gcloud storage ls -L'
alias ggcat='gcloud storage cat'
alias ggcc='gcloud compute instances'

alias ec="emacsclient -t --alternate-editor=''"

# uv venv helpers
alias vvdirenv='echo "layout uv" > .envrc && direnv allow'
alias vvup='source ./.venv/bin/activate'
alias vvinstall='uv pip install python-lsp-server basedpyright bump2version black debugpy pre-commit pytest ruff setuptools'

# Powerlevel10k
source "$(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Use Emacs's default socket ($TMPDIR/emacs<UID>/server) so shells and GUI apps
# (Finder, Dock, Emacs Client.app) all reach the same daemon. Don't start the
# daemon via `brew services` — launchd has no TMPDIR so it would bind to /tmp
# instead; let `emacsclient --alternate-editor=''` auto-start it here.
export EDITOR="emacsclient -t --alternate-editor=''"
export VISUAL="emacsclient -nw --alternate-editor=''"

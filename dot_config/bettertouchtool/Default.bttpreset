        {
          "BTTLastUpdatedAt" : 1775086063.283015,
          "BTTTriggerType" : 0,
          "BTTTriggerClass" : "BTTTriggerTypeKeyboardShortcut",
          "BTTUUID" : "2AEBDF0F-5998-4108-BCF1-2B1E56E8E304",
          "BTTAdditionalConfiguration" : "1966123",
          "BTTShortcutKeyboardType" : 1556,
          "BTTTriggerOnDown" : 1,
          "BTTLayoutIndependentChar" : "j",
          "BTTShortcutKeyCode" : 38,
          "BTTShortcutAdvancedModifierKeys" : "1966123",
          "BTTShortcutModifierKeys" : 1966080,
          "BTTOrder" : 1,
          "BTTAutoAdaptToKeyboardLayout" : 0,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1771280981.486517,
              "BTTTriggerParentUUID" : "2AEBDF0F-5998-4108-BCF1-2B1E56E8E304",
              "BTTIsPureAction" : true,
              "BTTTriggerClass" : "BTTTriggerTypeKeyboardShortcut",
              "BTTUUID" : "6633B454-9D41-4973-837F-A94DF700BD8A",
              "BTTPredefinedActionType" : 195,
              "BTTPredefinedActionName" : "Run Apple Script (async in background)",
              "BTTAdditionalActionData" : {
                "BTTAppleScriptRunInBackground" : true,
                "BTTAIScriptType" : 3,
                "BTTScriptType" : 0,
                "BTTAppleScriptString" : "set meetFound to false\n\n-- ---------------------------------------------------------\n-- PART 1: CHECK GOOGLE CHROME (works for Tabs & PWA)\n-- ---------------------------------------------------------\ntry\n\ttell application \"Google Chrome\"\n\t\t-- Loop through every tab in every Chrome window\n\t\trepeat with w in windows\n\t\t\trepeat with t in tabs of w\n\t\t\t\tif URL of t starts with \"https://meet.google.com\" then\n\t\t\t\t\t\n\t\t\t\t\t-- UPDATED JAVASCRIPT:\n\t\t\t\t\t-- 1. Uses 'querySelector' to find only the FIRST match (the main control bar).\n\t\t\t\t\t-- 2. Checks that the label starts with \"Turn\" (e.g., \"Turn off microphone\")\n\t\t\t\t\t--    to avoid clicking \"Microphone settings\" or other participants' mute buttons.\n\t\t\t\t\texecute t javascript \"var btn = document.querySelector('button[aria-label^=\\\"Turn\\\"][aria-label*=\\\"microphone\\\"]'); if (btn) { btn.click(); }\"\n\t\t\t\t\t\n\t\t\t\t\tset meetFound to true\n\t\t\t\t\texit repeat\n\t\t\t\tend if\n\t\t\tend repeat\n\t\t\tif meetFound then exit repeat\n\t\tend repeat\n\tend tell\non error\n\t-- If Chrome isn't open, just ignore and move to Gather check\n\tset meetFound to false\nend try\n\n-- ---------------------------------------------------------\n-- PART 2: CHECK GATHER OR FALLBACK\n-- ---------------------------------------------------------\nif meetFound is false then\n\ttell application \"System Events\"\n\t\tset runningProcesses to name of every application process\n\t\t\n\t\t-- CHECK FOR GATHER\n\t\tif \"Gather\" is in runningProcesses then\n\t\t\t\n\t\t\t-- 1. Remember where you are now\n\t\t\tset currentAppProcess to first application process whose frontmost is true\n\t\t\tset currentAppName to name of currentAppProcess\n\t\t\t\n\t\t\t-- 2. Switch to Gather\n\t\t\ttell process \"Gather\"\n\t\t\t\tset frontmost to true\n\t\t\tend tell\n\t\t\t\n\t\t\t-- 3. Wait for focus (crucial for keystrokes)\n\t\t\tdelay 0.1\n\t\t\t\n\t\t\t-- 4. Send Mute Command (Cmd + Shift + A)\n\t\t\tkeystroke \"a\" using {command down, shift down}\n\t\t\t\n\t\t\t-- 5. Switch back to your original app\n\t\t\ttell process currentAppName\n\t\t\t\tset frontmost to true\n\t\t\tend tell\n\t\t\t\n\t\t-- FALLBACK (Neither Meet nor Gather found)\n\t\telse\n\t\t\tkeystroke \"a\" using {command down, shift down}\n\t\tend if\n\tend tell\nend if",
                "SelectedAction" : 195,
                "BTTAppleScriptUsePath" : false,
                "BTTScriptLocation" : 0
              },
              "BTTInlineAppleScript" : "set meetFound to false\n\n-- ---------------------------------------------------------\n-- PART 1: CHECK GOOGLE CHROME (works for Tabs & PWA)\n-- ---------------------------------------------------------\ntry\n\ttell application \"Google Chrome\"\n\t\t-- Loop through every tab in every Chrome window\n\t\trepeat with w in windows\n\t\t\trepeat with t in tabs of w\n\t\t\t\tif URL of t starts with \"https://meet.google.com\" then\n\t\t\t\t\t\n\t\t\t\t\t-- UPDATED JAVASCRIPT:\n\t\t\t\t\t-- 1. Uses 'querySelector' to find only the FIRST match (the main control bar).\n\t\t\t\t\t-- 2. Checks that the label starts with \"Turn\" (e.g., \"Turn off microphone\")\n\t\t\t\t\t--    to avoid clicking \"Microphone settings\" or other participants' mute buttons.\n\t\t\t\t\texecute t javascript \"var btn = document.querySelector('button[aria-label^=\\\"Turn\\\"][aria-label*=\\\"microphone\\\"]'); if (btn) { btn.click(); }\"\n\t\t\t\t\t\n\t\t\t\t\tset meetFound to true\n\t\t\t\t\texit repeat\n\t\t\t\tend if\n\t\t\tend repeat\n\t\t\tif meetFound then exit repeat\n\t\tend repeat\n\tend tell\non error\n\t-- If Chrome isn't open, just ignore and move to Gather check\n\tset meetFound to false\nend try\n\n-- ---------------------------------------------------------\n-- PART 2: CHECK GATHER OR FALLBACK\n-- ---------------------------------------------------------\nif meetFound is false then\n\ttell application \"System Events\"\n\t\tset runningProcesses to name of every application process\n\t\t\n\t\t-- CHECK FOR GATHER\n\t\tif \"Gather\" is in runningProcesses then\n\t\t\t\n\t\t\t-- 1. Remember where you are now\n\t\t\tset currentAppProcess to first application process whose frontmost is true\n\t\t\tset currentAppName to name of currentAppProcess\n\t\t\t\n\t\t\t-- 2. Switch to Gather\n\t\t\ttell process \"Gather\"\n\t\t\t\tset frontmost to true\n\t\t\tend tell\n\t\t\t\n\t\t\t-- 3. Wait for focus (crucial for keystrokes)\n\t\t\tdelay 0.1\n\t\t\t\n\t\t\t-- 4. Send Mute Command (Cmd + Shift + A)\n\t\t\tkeystroke \"a\" using {command down, shift down}\n\t\t\t\n\t\t\t-- 5. Switch back to your original app\n\t\t\ttell process currentAppName\n\t\t\t\tset frontmost to true\n\t\t\tend tell\n\t\t\t\n\t\t-- FALLBACK (Neither Meet nor Gather found)\n\t\telse\n\t\t\tkeystroke \"a\" using {command down, shift down}\n\t\tend if\n\tend tell\nend if",
              "BTTShortcutKeyboardType" : 0,

font-family = Menlo
font-style = Regular
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
term = xterm-256color
theme = Doom One
macos-option-as-alt = true

working-directory = home
window-save-state = never

# Each instance quits when its last window closes, so the multiple
# app instances spawned by the aerospace launcher don't pile up.
quit-after-last-window-closed = true

keybind = ctrl+shift+alt+o=goto_split:up
keybind = ctrl+shift+alt+h=goto_split:left
keybind = ctrl+shift+alt+a=goto_split:down
keybind = ctrl+shift+alt+e=goto_split:right

keybind = ctrl+shift+alt+p=new_split:right
keybind = ctrl+shift+alt+f=new_split:down

keybind = ctrl+shift+alt+'=close_surface

keybind = ctrl+shift+alt+n=resize_split:left,10
keybind = ctrl+shift+alt+r=resize_split:up,10
keybind = ctrl+shift+alt+t=resize_split:down,10
keybind = ctrl+shift+alt+s=resize_split:right,10

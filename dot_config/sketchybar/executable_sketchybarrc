#!/bin/bash


PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Bar appearance
sketchybar --bar \
  height=25 \
  position=top \
  sticky=on \
  padding_left=10 \
  padding_right=10 \
  color=0xcc000000

# Defaults
sketchybar --default \
  icon.font="Inconsolata:Light:13.0" \
  label.font="Inconsolata:Light:13.0" \
  icon.color=0xffffffff \
  label.color=0xffffffff \
  padding_left=4 \
  padding_right=4

# Aerospace workspaces (left)
sketchybar --add event aerospace_workspace_change
sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged

for sid in B L D C V N R T S G; do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change \
    --set "space.$sid" \
      icon="$sid" \
      label.font="Inconsolata Nerd Font Mono:Regular:13.0" \
      label.padding_right=45 \
      background.color=0xffffffff \
      background.height=2 \
      background.corner_radius=0 \
      background.y_offset=-10 \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# Populate icons at startup
INIT_FOCUSED="$(aerospace list-workspaces --focused 2>/dev/null | head -1)"
for sid in B L D C V N R T S G; do
  NAME="space.$sid" FOCUSED_WORKSPACE="$INIT_FOCUSED" \
    "$PLUGIN_DIR/aerospace.sh" "$sid" &
done
wait

# Clock (right)
sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  label.padding_right=4 \
  script="$PLUGIN_DIR/clock.sh"

# Battery (right)
sketchybar --add item battery right \
  --set battery \
  update_freq=60 \
  padding_left=18 \
  label.padding_right=8 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Spotify (right)
sketchybar --add item spotify right \
  --subscribe spotify spotify_change \
  --set spotify \
    drawing=off \
    script="$PLUGIN_DIR/spotify.sh"
NAME="spotify" "$PLUGIN_DIR/spotify.sh"

# Calendar (right)
sketchybar --add item calendar right \
  --set calendar \
  update_freq=60 \
  drawing=off \
  script="$PLUGIN_DIR/calendar.sh"

sketchybar --update
